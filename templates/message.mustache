{{!
    @template block_cortex_chat/message

    A single chat message (user or assistant).

    Context variables required for this template:
    * isuser - Whether this is the student's message.
    * rolelabel - Localised speaker label.
    * message - The message text (plain; rendered as escaped text).
    * hassources - Whether a sources list follows.
    * sources - Array of {index, reference}.

    Example context (json):
    {
        "isuser": false,
        "rolelabel": "Course assistant",
        "message": "The mitochondria is the powerhouse of the cell [1].",
        "hassources": true,
        "sources": [{"index": 1, "reference": "Topic 2 / Cell biology"}]
    }
}}
<div class="block-cortex-chat-message {{#isuser}}block-cortex-chat-message-user{{/isuser}}{{^isuser}}block-cortex-chat-message-assistant{{/isuser}}">
    <div class="block-cortex-chat-role small font-weight-bold fw-bold">{{rolelabel}}</div>
    <div class="block-cortex-chat-text">{{message}}</div>
    {{#hassources}}
    <div class="block-cortex-chat-sources mt-1">
        <div class="small font-weight-bold fw-bold">{{#str}}sourcesheading, block_cortex_chat{{/str}}</div>
        <ol class="block-cortex-chat-sources-list small pl-3 ps-3 mb-0">
            {{#sources}}
            <li>{{reference}}</li>
            {{/sources}}
        </ol>
    </div>
    {{/hassources}}
</div>
