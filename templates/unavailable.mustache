{{!
    @template block_cortex_chat/unavailable

    Shown when the chat cannot operate.

    Context variables required for this template:
    * message - Localised, non-sensitive unavailable message.
    * isstaff - Whether to show the staff detail.
    * detail - Staff-only detail string.

    Example context (json):
    {
        "message": "This course's knowledge base is not ready yet. Please check back later.",
        "isstaff": true,
        "detail": "Course corpus status: processing."
    }
}}
<div class="block-cortex-chat-unavailable">
    <p class="text-muted mb-1">{{message}}</p>
    {{#isstaff}}
        {{#detail}}
        <div class="alert alert-info small mt-2 mb-0" role="status">
            <strong>{{#str}}staffdiagnostics, block_cortex_chat{{/str}}:</strong> {{detail}}
        </div>
        {{/detail}}
    {{/isstaff}}
</div>
